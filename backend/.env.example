# ===== 应用 =====
APP_ENV=development
DEBUG=true

# ===== 数据库 =====
DATABASE_URL=sqlite:///./rag_demo.db

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 种子账号（启动时幂等创建，密码留空则跳过；生产环境务必改掉）=====
# expert 角色额外拥有内容纠错/专家标注权限（需求⑤）
SEED_EXPERT_USERNAME=expert
SEED_EXPERT_PASSWORD=
SEED_USER_USERNAME=user01
SEED_USER_PASSWORD=

# ===== Dify =====
DIFY_BASE_URL=http://localhost
# 知识库（数据集）API Key，Dify 控制台「知识库 → API」生成，dataset- 开头
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Dify 应用级 API Key（按业务场景隔离）
DIFY_CHAT_APP_KEY=
DIFY_CONTRACT_REVIEW_APP_KEY=
DIFY_REGULATION_REVIEW_APP_KEY=
DIFY_GENERATE_APP_KEY=

# ===== 知识库 dataset_id（建库后在知识库 URL 或 GET /v1/datasets 获取）=====
DATASET_ID_LAW=
DATASET_ID_REGULATION=
DATASET_ID_CASE=
DATASET_ID_RULE=
DATASET_ID_EXPERT=

# ===== 知识库 / 向量 =====
EMBEDDING_MODEL=

# ===== CORS =====
# CORS_ORIGINS 默认允许本地前端，如需追加用逗号分隔
