# ===== 应用 =====
APP_ENV=development
DEBUG=true

# ===== 数据库 =====
DATABASE_URL=sqlite:///./rag_demo.db

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== Dify =====
DIFY_BASE_URL=http://localhost
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Dify 应用级 API Key（按业务场景隔离）
DIFY_CHAT_APP_KEY=
DIFY_REVIEW_APP_KEY=
DIFY_GENERATE_APP_KEY=

# ===== 知识库 / 向量 =====
EMBEDDING_MODEL=

# ===== CORS =====
# CORS_ORIGINS 默认允许本地前端，如需追加用逗号分隔
