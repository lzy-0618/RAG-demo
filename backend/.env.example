# ===== 应用 =====
APP_ENV=development
DEBUG=true

# ===== 数据库 =====
DATABASE_URL=sqlite:///./rag_demo.db

# ===== JWT =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 种子账号（启动时幂等创建，密码留空则跳过；生产环境务必改掉）=====
# expert 角色额外拥有内容纠错/专家标注权限（需求⑤）
SEED_EXPERT_USERNAME=expert
SEED_EXPERT_PASSWORD=
SEED_USER_USERNAME=user01
SEED_USER_PASSWORD=

# ===== Dify =====
DIFY_BASE_URL=http://localhost
# 知识库（数据集）API Key，Dify 控制台「知识库 → API」生成，dataset- 开头
DIFY_API_KEY=
DIFY_TIMEOUT=60

# Dify 应用级 API Key（按业务场景隔离）
DIFY_CHAT_APP_KEY=
DIFY_CONTRACT_REVIEW_APP_KEY=
DIFY_REGULATION_REVIEW_APP_KEY=
DIFY_GENERATE_APP_KEY=
# 应用六：合同模板结构化（dify/dsl/合同模板结构化.yml，导入后生成 API Secret）
DIFY_TEMPLATE_STRUCTURE_APP_KEY=

# ===== 知识库 dataset_id（建库后在知识库 URL 或 GET /v1/datasets 获取）=====
DATASET_ID_LAW=
DATASET_ID_REGULATION=
DATASET_ID_CASE=
DATASET_ID_RULE=
DATASET_ID_EXPERT=

# ===== 知识库 / 向量 =====
EMBEDDING_MODEL=

# ===== CORS =====
# CORS_ORIGINS 默认允许本地前端，如需追加用逗号分隔

# ===== 文档预览：docx → PDF（LibreOffice headless）=====
# 留空自动探测 PATH 与 /Applications/LibreOffice.app（macOS 可 brew install --cask libreoffice）
LIBREOFFICE_BIN=
# 字体目录，逗号分隔。留空按平台自动探测。
# 容器内必须显式指定并安装中文字体包，否则 PDF 里中文会变成空白：
#   apt-get install -y fonts-noto-cjk && PDF_FONT_DIRS=/usr/share/fonts
PDF_FONT_DIRS=
# 复用 profile 目录（每进程一个，进程内串行；详见 docs/PDF中文字体渲染问题排查经验.md）
PDF_PROFILE_DIR=var/lo-profile
# PDF 产物缓存（内容哈希命名）与生成的 fontconfig 都在这里
PDF_CACHE_DIR=var/pdf-cache
PDF_CONVERT_TIMEOUT=120
# soffice 共用 profile 会锁冲突，必须串行
PDF_CONVERT_CONCURRENCY=1
# 中文墨迹自检阈值：低于此值判定字形缺失，宁可报错也不返回空白件
PDF_CJK_INK_MIN_RATIO=0.005
