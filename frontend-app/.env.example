# App 构建配置示例。真实值放 .env.android（vite build --mode android 读取），不要提交。
# 真机调试：把 VITE_API_BASE_URL 改成 Mac 的局域网 IP，并在后端 CORS_ORIGINS 与
# android/app/src/main/res/xml/network_security_config.xml 里各补一条放行。

# 后端 API 基地址。10.0.2.2 是 Android 模拟器指向宿主机回环地址的固定别名
VITE_API_BASE_URL=http://10.0.2.2:8000/api/v1

# 登录页是否展示演示账号（含复制按钮）。默认关闭，只有显式写 true 才展示；
# 关闭时凭据会被打包器消除，不进 JS 产物
VITE_SHOW_DEMO_ACCOUNTS=true
